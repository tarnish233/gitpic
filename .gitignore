/target
**/*.rs.bk
.DS_Store
/dist-app
/apps/GitPic/.build
# Per-agent worktrees and the scratch config/env they get, so one agent's
# isolation never surfaces as untracked files in another agent's checkout.
# `.claude/worktrees/` is where Claude Code's own worktree tooling puts them;
# scripts/new-worktree.sh deliberately uses a sibling directory instead.
/.claude/worktrees/
/.local/
# `check_manifests.py` imports `release_notes`, so running it locally byte-compiles
# that module. CI does not care, but an untracked directory appearing in everyone's
# `git status` after every manifest check would be noise.
/.github/scripts/__pycache__/
